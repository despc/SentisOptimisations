<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SentisOptimisations</AssemblyName>
    <RootNamespace>SentisOptimisations</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0168;CS0219;CS0414;CS0649;CS1591;CS0108;CS0114;NU1701</NoWarn>
    <!-- Root for Space Engineers dedicated server / torch install -->
    <SeRoot Condition="'$(SeRoot)' == ''">C:\SE</SeRoot>
    <SeDs>$(SeRoot)\DedicatedServer64</SeDs>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Torch -->
    <Reference Include="Torch"><HintPath>$(SeRoot)\Torch.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Torch.API"><HintPath>$(SeRoot)\Torch.API.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="NLog"><HintPath>$(SeRoot)\NLog.dll</HintPath><Private>False</Private></Reference>
    <!-- Vendored -->
    <Reference Include="0Harmony"><HintPath>lib\0Harmony.dll</HintPath><Private>False</Private></Reference>
    <!-- Profiler.dll is loaded lazily at runtime (it ships as a separate Torch plugin and carries its own ITorchPlugin implementation). -->
    <!-- Game -->
    <Reference Include="HavokWrapper"><HintPath>$(SeDs)\HavokWrapper.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(SeDs)\Microsoft.CodeAnalysis.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(SeDs)\Microsoft.CodeAnalysis.CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="ProtoBuf.Net"><HintPath>$(SeDs)\ProtoBuf.Net.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="ProtoBuf.Net.Core"><HintPath>$(SeDs)\ProtoBuf.Net.Core.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Sandbox.Common"><HintPath>$(SeDs)\Sandbox.Common.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Sandbox.Game"><HintPath>$(SeDs)\Sandbox.Game.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Sandbox.Graphics"><HintPath>$(SeDs)\Sandbox.Graphics.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Sandbox.RenderDirect"><HintPath>$(SeDs)\Sandbox.RenderDirect.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SpaceEngineers.Game"><HintPath>$(SeDs)\SpaceEngineers.Game.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SpaceEngineers.ObjectBuilders"><HintPath>$(SeDs)\SpaceEngineers.ObjectBuilders.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="System.Collections.Immutable"><HintPath>$(SeDs)\System.Collections.Immutable.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage"><HintPath>$(SeDs)\VRage.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Game"><HintPath>$(SeDs)\VRage.Game.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Library"><HintPath>$(SeDs)\VRage.Library.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Math"><HintPath>$(SeDs)\VRage.Math.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Network"><HintPath>$(SeDs)\VRage.Network.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Platform.Windows"><HintPath>$(SeDs)\VRage.Platform.Windows.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.RemoteClient.Core"><HintPath>$(SeDs)\VRage.RemoteClient.Core.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Render"><HintPath>$(SeDs)\VRage.Render.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Render11"><HintPath>$(SeDs)\VRage.Render11.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Scripting"><HintPath>$(SeDs)\VRage.Scripting.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
