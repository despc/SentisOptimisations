<?xml version="1.0" encoding="utf-8"?>
<!--
  Пример настроек SentisOptimisations со значениями по умолчанию.
  Файл сервера: Instance\SentisOptimisations.cfg (Torch создаёт его при первом запуске).
  Этот файл можно скопировать туда как есть: комментарии при чтении пропускаются.
  Параметр, которого нет в файле, берёт значение по умолчанию.
  Подробности о каждой возможности: README.md.
-->
<MainConfig xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- ================================ Сторож тяжёлой физики ================================ -->

  <!-- Включает сторожа: он ищет группу гридов, которая грузит физику сервера, предупреждает владельца
       и, если нагрузка держится, переводит группу в статику. -->
  <EnablePhysicsGuard>true</EnablePhysicsGuard>

  <!-- Миллисекунды физики на кадр, с которых начинается разбор нагрузки и владелец виновной группы
       получает предупреждение. -->
  <PhysicsMsToAlert>1.5</PhysicsMsToAlert>

  <!-- Миллисекунды физики на кадр, при которых группа переводится в статику после
       PhysicsChecksBeforePunish проваленных проверок. -->
  <PhysicsMsToPunish>2</PhysicsMsToPunish>

  <!-- Миллисекунды физики на кадр, при которых группа переводится в статику сразу. -->
  <PhysicsMsToPunishImmediately>5</PhysicsMsToPunishImmediately>

  <!-- Сколько проваленных проверок (за последние 10 минут) нужно до перевода в статику. -->
  <PhysicsChecksBeforePunish>5</PhysicsChecksBeforePunish>

  <!-- ================================ Газ ================================ -->

  <!-- Газовые баки и вентиляция переносят газ одной пачкой на тридцать обновлений вместо тридцати
       проходов по конвейерной сети. Газ не теряется. -->
  <GasTankOptimisation>true</GasTankOptimisation>

  <!-- ================================ Безопасные зоны ================================ -->

  <!-- Зоны находят динамические гриды по геометрии, а не через физический «фантом»: сварка и
       разборка грида внутри зоны перестают нагружать физику. false - как в ванильной игре.
       Действует на зоны, созданные или перестроенные после изменения, на все - после перезапуска. -->
  <SafeZoneGridTracking>true</SafeZoneGridTracking>

  <!-- ================================ Сварка ================================ -->

  <!-- Оптимизированная сварка проекций и блоков. false - ванильные сварщики. -->
  <WelderTweaksEnabled>true</WelderTweaksEnabled>

  <!-- Сварщик может в одной активации варить и обычные блоки, и проекцию (быстрее, но тяжелее для
       сервера). false - проекция варится только в активации, где нечего было варить. -->
  <WelderTweaksCanWeldProjectionsIfWeldedOtherBlocks>false</WelderTweaksCanWeldProjectionsIfWeldedOtherBlocks>

  <!-- Сварщик может чинить сам себя. -->
  <WelderTweaksSelfWelding>true</WelderTweaksSelfWelding>

  <!-- Сколько блоков проекции весь сервер строит за один кадр (общий лимит для всех сварщиков).
       Минимум 1, меняется на лету. -->
  <ProjectionBuildsPerFrame>1</ProjectionBuildsPerFrame>

  <!-- ================================ Заморозка (фризер) ================================ -->

  <!-- Гриды, рядом с которыми нет игроков, перестают обсчитываться. -->
  <FreezerEnabled>true</FreezerEnabled>

  <!-- Дальше какого расстояния от ближайшего игрока замерзает динамическая группа, м. -->
  <FreezeDistanceDynamic>10000</FreezeDistanceDynamic>

  <!-- Дальше какого расстояния замерзает группа, в которой есть статичный грид, м. -->
  <FreezeDistanceStatic>3000</FreezeDistanceStatic>

  <!-- Замораживать NPC-гриды. -->
  <FreezeNpc>false</FreezeNpc>

  <!-- Замораживать контейнеры-сигналы (гриды с «Container MK-» в имени). -->
  <FreezeSignals>false</FreezeSignals>

  <!-- Сабтипы блоков через «:». Группа, в которой есть такой блок, никогда не замерзает. -->
  <AntifreezeBlocksSubtypes>LargeBlockSmallContainer_admin2:LargeBlockSmallContainer_admin</AntifreezeBlocksSubtypes>

  <!-- Раз во сколько секунд замороженная группа с производством (заводы, сборщики) просыпается на
       несколько секунд, чтобы отработать пропущенное время. -->
  <MinWakeUpIntervalInSec>600</MinWakeUpIntervalInSec>

  <!-- Подробный лог заморозки и разморозки. -->
  <EnableDebugLogs>true</EnableDebugLogs>

  <!-- Сколько секунд ждать после ухода игроков, прежде чем заморозить группу. -->
  <DelayBeforeFreezeSec>5</DelayBeforeFreezeSec>

  <!-- Через сколько секунд после загрузки мира фризер начинает работать. -->
  <DelayBeforeFreezerStartSec>5</DelayBeforeFreezerStartSec>

  <!-- Писать в лог итоги компенсации производства замороженных гридов. -->
  <EnableCompensationLogs>true</EnableCompensationLogs>

  <!-- Замораживать и физику: тела Havok замороженных гридов переводятся в Fixed и не стоят ничего.
       Сам грид статичным не становится. Переключается на лету. -->
  <FreezePhysics>false</FreezePhysics>

  <!-- ================================ Прочее ================================ -->

  <!-- На скольких потоках Havok считает шаг физики. Применяется после рестарта. По умолчанию 80%
       логических ядер процессора; строка закомментирована, чтобы число считалось само. -->
  <!-- <PhysicsThreads>13</PhysicsThreads> -->

  <!-- Писать в лог исключения игры, которые плагин подавляет, чтобы сервер не падал. -->
  <EnableMainDebugLogs>false</EnableMainDebugLogs>

  <!-- ================================ Программные блоки ================================ -->

  <!-- Выводить из строя программные блоки, которые слишком часто выходят за бюджет (см. ниже). Без
       этого нагрузка только считается и видна в GUI плагина (секция Scripts). -->
  <EnableScriptsPunish>false</EnableScriptsPunish>

  <!-- Предел одного запуска скрипта, мс. -->
  <ScriptsMaxExecTime>2</ScriptsMaxExecTime>

  <!-- Предел среднего времени скрипта на кадр, мс: скрипт на Update1 по 0.8 мс стоит 0.8 мс каждого
       кадра. 0 - этот предел выключен. -->
  <ScriptsMaxMsPerFrame>0.5</ScriptsMaxMsPerFrame>

  <!-- Блок выводится из строя, когда среди его последних 20 запусков больше стольких вышли за
       ScriptsMaxExecTime или ScriptsMaxMsPerFrame. -->
  <ScriptOvertimeExecTimesBeforePunish>3</ScriptOvertimeExecTimesBeforePunish>

</MainConfig>
